# Orange Hat Childcare Foundation Environment Variables
# Copy this file to .env and fill in your actual values

# API Configuration
VITE_API_BASE_URL=https://api.orange-hat.org
VITE_CONTACT_EMAIL=info@orange-hat.org
VITE_PHONE_NUMBER=+234-XXX-XXX-XXXX

# Social Media Links (Update with actual organization URLs)
VITE_FACEBOOK_URL=https://facebook.com/orangehatchildcare
VITE_INSTAGRAM_URL=https://instagram.com/orangehatchildcare
VITE_YOUTUBE_URL=https://youtube.com/@orangehatchildcare
VITE_TWITTER_URL=https://twitter.com/orangehatchildcare

# Google Analytics (optional)
VITE_GA_TRACKING_ID=

# Map Configuration (optional)
VITE_GOOGLE_MAPS_API_KEY=

# Organization Details
VITE_ORG_NAME=Orange Hat Childcare Foundation
VITE_ORG_ADDRESS=COCIN Church Jiyep, Hwolshe, Jos, Plateau State, Nigeria
VITE_ORG_EMAIL=info@orangehat.org

# Payment Integration
# Public key only; never put a Paystack secret key in a VITE_ variable.
# Use pk_test_... for development or pk_live_... for real donations.
VITE_PAYSTACK_PUBLIC_KEY=
VITE_DONATION_URL=https://paystack.shop/pay/orange-hat

# Instagram Sync (Meta Graph API)
# Required for the reliable automatic Instagram feed.
# Get these values from your Meta app connected to the Instagram Business account.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_MEDIA_COUNT=6
INSTAGRAM_USERNAME=orange_hat_foundation
INSTAGRAM_PROFILE_URL=https://www.instagram.com/orange_hat_foundation/

# Development Settings
# Keep program cards static until more photos are ready. Set true to restore rotation.
VITE_ENABLE_PROGRAM_SLIDESHOW=false
VITE_ENABLE_ANALYTICS=false
VITE_DEBUG_MODE=false
